# Optional. Public positioning and dry-run work without these.
BINANCE_API_KEY=
BINANCE_SECRET_KEY=

# Bitunix USD-M accounts (never commit real keys).
# 1 muphasa · 2 merrijeh · 3 ekeson · 4 kazi
# BITUNIX_NAME=muphasa
# BITUNIX_API_KEY=
# BITUNIX_SECRET_KEY=
# BITUNIX_NAME_2=merrijeh
# BITUNIX_API_KEY_2=
# BITUNIX_SECRET_KEY_2=
# BITUNIX_ACCESS_2=
# BITUNIX_NAME_3=ekeson
# BITUNIX_API_KEY_3=
# BITUNIX_SECRET_KEY_3=
# BITUNIX_ACCESS_3=
# BITUNIX_NAME_4=kazi
# BITUNIX_API_KEY_4=
# BITUNIX_SECRET_KEY_4=
# BITUNIX_ACCESS_4=
# FXGLITCH_AUTO_SLOTS=2,3


# Telegram user QR login (account already in the Bitunix group).
# Get these from https://my.telegram.org → API development tools.
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Optional bot path (only if you also add a bot to the group).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: forward ingested signals to the hosted desk
# FXGLITCH_INBOX_WEBHOOK=https://fxglitch.xyz/api/telegram

# Optional demo futures endpoint. Default is https://fapi.binance.com
# BINANCE_FUTURES_BASE_URL=https://demo-fapi.binance.com

# Set to 1 only when you intend to send. The CLI also requires --live.
# FXGLITCH_LIVE=0

# --- Grok operator bot (Telegram DMs; Cosmas group stays on Telethon user) ---
# XAI_API_KEY=
# FXGLITCH_GROK_BOT=1
# FXGLITCH_GROK_BOT_TOKEN=   # optional; defaults to TELEGRAM_BOT_TOKEN
# FXGLITCH_GROK_BOT_ALLOW_IDS=  # comma telegram user ids; else access-code gate
# FXGLITCH_GROK_ALERT_CHAT_ID=  # chat that receives catch-up ACTION alerts
# FXGLITCH_GROK_MODEL=grok-4

# Cosmas catch-up window for systemd timer (hours)
# COSMAS_CATCHUP_HOURS=18
# FXGLITCH_AUTO_TRADE=1
# FXGLITCH_AUTO_SLOTS=2,3,4,5
# FXGLITCH_AUTO_RISK=5
# FXGLITCH_MIN_LIVE_RR=0.5
# FXGLITCH_TRAIL_STEP=200
